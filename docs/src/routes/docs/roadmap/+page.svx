<script>
	let { data } = $props();

	const completed = $derived(data.milestones.filter((m) => m.target === 'Completed'));
	const inProgress = $derived(data.milestones.filter((m) => m.target === 'In progress'));
</script>

<svelte:head>
	<title>Roadmap • PARA Docs</title>
	<meta
		name="description"
		content="Current milestones for PARA documentation and schema reference coverage."
	/>
</svelte:head>

<section class="docs-hero-card">
	<p class="docs-hero-kicker">Roadmap</p>
	<h1>Roadmap</h1>
	<p>
		This page tracks documentation and reference coverage milestones. It is updated from the
		plan fixture in the content-schema package and reflects the current state of the docs site.
	</p>
</section>

{#if inProgress.length > 0}
	<section class="docs-section-card">
		<p class="docs-section-kicker">In progress</p>
		<div class="docs-meta-grid">
			{#each inProgress as milestone (milestone.id)}
				<div class="docs-meta-card">
					<span class="docs-meta-label">{milestone.title}</span>
					<div class="docs-meta-value">{milestone.summary}</div>
				</div>
			{/each}
		</div>
	</section>
{/if}

{#if completed.length > 0}
	<section class="docs-section-card">
		<p class="docs-section-kicker">Completed</p>
		<div class="docs-meta-grid">
			{#each completed as milestone (milestone.id)}
				<div class="docs-meta-card">
					<span class="docs-meta-label">{milestone.title}</span>
					<div class="docs-meta-value">{milestone.summary}</div>
				</div>
			{/each}
		</div>
	</section>
{/if}
